# SYNC.md is the source of truth. This file is a second safety layer.

# Machine-local profile selection
.dots-profile

# Shared instructions and skills
profiles/*/dotagents/*
!profiles/*/dotagents/AGENTS.md
!profiles/*/dotagents/skills/
!profiles/*/dotagents/skills/**
profiles/*/dotagents/skills/**/.git/

# Allow only curated Codex files inside each profile.
profiles/*/dotcodex/*
!profiles/*/dotcodex/config.toml
!profiles/*/dotcodex/model-instructions.md

.backup/
