#!/bin/sh

set -eu

usage() {
  printf 'Usage: %s {backup|restore|status}\n' "$0" >&2
  exit 2
}

[ "$#" -eq 1 ] || usage

if ! command -v codex >/dev/null 2>&1; then
  printf 'Error: codex is not available on PATH.\n' >&2
  exit 127
fi

repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

case "$1" in
  backup)
    prompt='Read SYNC.md completely, then perform its Backup procedure from the live home configuration into this repository. This request authorizes writes only inside this repository. Preserve unrelated worktree changes. Enforce the allowlist and config.toml curation rules. Do not copy authentication or machine state. Validate the result, show the exact Git diff, and stop without committing or pushing.'
    ;;
  restore)
    prompt='Read SYNC.md completely, then perform its Restore procedure from this repository into the live home configuration. Before overwriting a live file or skill, create a recoverable backup under ~/.codex/backups/. This request authorizes writes only to the allowlisted ~/.agents and ~/.codex configuration paths. Preserve authentication, sessions, app-managed system skills, and machine state. Request approval when the sandbox requires it. Validate the restored files and report the backup location. Do not commit or push.'
    ;;
  status)
    prompt='Read SYNC.md completely. Compare the allowlisted live home configuration with this repository. Report drift, sanitization differences, and whether backup or restore is the appropriate next action. Do not edit files, configuration, Git state, or authentication.'
    ;;
  *)
    usage
    ;;
esac

exec codex --cd "$repo_dir" "$prompt"
